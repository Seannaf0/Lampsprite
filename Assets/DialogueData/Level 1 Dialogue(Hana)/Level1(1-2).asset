  m_Script: {fileID: 11500000, guid: 4857918aa396e664da4bf6e1e0405844, type: 3}
  m_Name: Level1(1-2)
  m_EditorClassIdentifier: 
  dialogue:
  - "That\u2019s incredible! Tell me more about your work. It sounds like you were
    really important."
  - "Well\u2026 But I\u2019m something of an icon in the lamp industry. Claire herself
    relied on my expertise, you know. \r"
  - "I\u2019ve crafted some of the most exquisite designs of our time. It\u2019s
    a shame no one here has pointed it out yet. Perhaps my peers are humbled to the
    point of bashfulness.\r\nBut true artistry speaks for itself."
  - "One day, they\u2019ll all recognize my contributions. They\u2019ll have to.\n"
  responses:
  - responseText: Most Beloved Piece?
    dialogueObject: {fileID: 11400000, guid: 8c6239ff49a35694db33a341d8163724, type: 2}
  - responseText: Anyone Envious?
    dialogueObject: {fileID: 11400000, guid: f0b6c342cc28ac049aa49c5d1f46e8bd, type: 2}
