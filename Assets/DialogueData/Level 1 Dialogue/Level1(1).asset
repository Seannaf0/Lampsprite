  m_Script: {fileID: 11500000, guid: 4857918aa396e664da4bf6e1e0405844, type: 3}
  m_Name: Level1(1)
  m_EditorClassIdentifier: 
  dialogue:
  - "Hey! You\u2019re that interviewer or whatever that\u2019s supposed to help get
    me out of here, right?\r"
  - "The museum staff said that I should answer as many of your questions as possible.\r\nBut
    visitors aren\u2019t allowed to be here for long, so I doubt you\u2019ll get
    that many in.\r"
  - "I\u2019m pretty sure Hana doesn't like it here very much.\r\nI don\u2019t have
    many problems with the museum myself, but I\u2019d have to agree that I want
    to leave at least once.\r\n"
  - "So, uh, got any questions for me?\r"
  responses:
  - responseText: Free time?
    dialogueObject: {fileID: 11400000, guid: 075df24f50fccd24b9dee10119d54c98, type: 2}
    responseChange: 0
  - responseText: Once you leave?
    dialogueObject: {fileID: 11400000, guid: 5814567e5693aa64f8df2c6bc0ba5f19, type: 2}
    responseChange: 0
