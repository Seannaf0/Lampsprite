  m_Script: {fileID: 11500000, guid: 4857918aa396e664da4bf6e1e0405844, type: 3}
  m_Name: Level2(1-A)
  m_EditorClassIdentifier: 
  dialogue:
  - '"What would you like to do once you leave the museum...?"'
  - "It\u2019d be cool to be something like a detective\u2026 or a private investigator!\r\nI\u2019ve
    been reading a lot of comics with detectives in them, and they seem neat.\r"
  - "I don\u2019t know if I could solve a real mystery, though. I would prefer to
    solve a fake one, because it\u2019s lower stakes."
  responses:
  - responseText: Working Together!
    dialogueObject: {fileID: 11400000, guid: 5fec31ed3fa7fd541a8c911c45498e6e, type: 2}
  - responseText: Let go of Dreams.
    dialogueObject: {fileID: 11400000, guid: dad24782e7ad9a74390b8f42d95128ed, type: 2}
